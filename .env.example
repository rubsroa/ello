# Application
APP_URL=http://localhost:3000
DOMAIN=ello-coiffure.ch
NODE_ENV=development
TZ=Europe/Zurich

# MySQL
DATABASE_URL=mysql://salon_user:change_me@db:3306/salon
MYSQL_DATABASE=salon
MYSQL_USER=salon_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

# Authentication and encryption (generate at least 32 random bytes)
AUTH_SECRET=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
DEV_ADMIN_EMAIL=admin@ello-coiffure.local
DEV_ADMIN_PASSWORD=

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Stripe (optional)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email: smtp or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=ell’o Genève <bonjour@ello-coiffure.ch>
SALON_NOTIFICATION_EMAIL=bonjour@ello-coiffure.ch
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
CRON_SECRET=

# Booking policy
BOOKING_MIN_NOTICE_MINUTES=120
BOOKING_MAX_ADVANCE_DAYS=90
BOOKING_HOLD_MINUTES=31
BOOKING_SLOT_MINUTES=15

# Uploads
MAX_UPLOAD_BYTES=5242880
