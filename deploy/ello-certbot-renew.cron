SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Check daily; Certbot only renews certificates that are close to expiry.
23 3 * * * root cd /srv/ello && docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile certbot run --rm certbot renew --webroot -w /var/www/certbot --quiet && docker compose -f docker-compose.yml -f docker-compose.prod.yml exec -T nginx nginx -s reload >> /var/log/ello-certbot.log 2>&1
